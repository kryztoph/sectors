<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fox.sectors.cotpy.weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__ROOT_DIR__/scripts/run_weekly.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>5</integer>
    <key>Hour</key>
    <integer>17</integer>
    <key>Minute</key>
    <integer>45</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__ROOT_DIR__/logs/cotpy-weekly.out</string>

  <key>StandardErrorPath</key>
  <string>__ROOT_DIR__/logs/cotpy-weekly.err</string>
</dict>
</plist>
